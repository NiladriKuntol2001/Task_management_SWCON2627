# Copy this file to .env and fill in real values before running.

# PostgreSQL connection used by the app (see docker-compose.yml for the matching service)
DATABASE_URL=postgresql+psycopg2://taskuser:taskpass@db:5432/taskmanager

# Secret used to sign JWT access tokens. Generate your own, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret

# JWT settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Main administrator = user ID 1. Created on first startup with these
# credentials (never overwritten later). The email is fixed; the password can
# be changed afterwards from the admin's profile page.
ADMIN_EMAIL=admin123@gmail.com
ADMIN_PASSWORD=admin@123
ADMIN_NAME=Administrator
